{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Site": {
    "DatabasePath": "",
    "StateDirectory": "App_Data",
    "Demo": false,
    "AllowDevelopmentGuest": false,
    "MaxPageSize": 50,
    "MaxAccessibleRows": 1000,
    "RequestsPerMinute": 30,
    "IpRequestsPerMinute": 90,
    "DailyQueries": 2000,
    "DailyRows": 60000,
    "ConcurrentQueries": 2,
    "QuerySeconds": 30,
    "TrustedProxies": [],
    "AllowedOrigins": [],
    "Users": [],
    "ShowWar": true
  },
  "RenderCollector": {
    "Enabled": true,
    "IntervalMinutes": 10,
    "LookbackDays": 1,
    "JsonDirectory": "/var/data/kbo-json",
    "HeartbeatPath": "/var/data/kbo-render-collector.heartbeat"
  }
}
