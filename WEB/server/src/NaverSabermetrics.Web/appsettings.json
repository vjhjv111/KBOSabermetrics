{
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Site": {
    "DatabasePath": "",
    "StateDirectory": "App_Data",
    "Demo": false,
    "AllowDevelopmentGuest": false,
    "MaxPageSize": 50,
    "MaxAccessibleRows": 1000,
    "RequestsPerMinute": 30,
    "IpRequestsPerMinute": 90,
    "DailyQueries": 2000,
    "DailyRows": 60000,
    "ConcurrentQueries": 4,
    "QuerySeconds": 30,
    "TrustedProxies": [],
    "AllowedOrigins": [],
    "Users": [],
    "ShowWar": true
  },
  "RenderCollector": {
    "Enabled": true,
    "IntervalMinutes": 10,
    "LookbackDays": 1,
    "JsonDirectory": "/var/data/kbo-json",
    "HeartbeatPath": "/var/data/kbo-render-collector.heartbeat",
    "ManualTriggerPath": "/var/data/kbo-render-collector.trigger",
    "ReconcileOfficialRecords": true,
    "ReconciliationRetryMinutes": 10,
    "ReconciliationStatePath": "/var/data/kbo-render-reconciliation.json",
    "BackfillEnabled": false,
    "BackfillFromDate": "2008-03-01",
    "BackfillChunkDays": 30,
    "BackfillStatePath": "/var/data/kbo-render-backfill.json"
  }
}
