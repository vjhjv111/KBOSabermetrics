<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>NaverSabermetrics.Web</AssemblyName>
    <RootNamespace>NaverSabermetrics.Web</RootNamespace>
    <UserSecretsId>naver-sabermetrics-web-warv3</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../NaverRelay.Infrastructure.Sqlite/NaverRelay.Infrastructure.Sqlite.csproj" />
    <ProjectReference Include="../NaverRelay.Application/NaverRelay.Application.csproj" />
    <ProjectReference Include="../NaverRelay.Parser/NaverRelay.Parser.csproj" />
    <!-- Explicit physical items prevent an absent project wwwroot in the SDK manifest.
         Only these public files are packaged. frontend/ remains the editable source. -->
    <Content Remove="wwwroot/**" />
    <Content Include="wwwroot/index.html;wwwroot/app.css;wwwroot/home.css;wwwroot/player-profile.css;wwwroot/app.js;wwwroot/games.js;wwwroot/diamond.js;wwwroot/analysis.js;wwwroot/analysis.css;wwwroot/comparison.js;wwwroot/comparison.css"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <FrontendAsset Include="$(MSBuildProjectDirectory)/../../../frontend/index.html" />
    <FrontendAsset Include="$(MSBuildProjectDirectory)/../../../frontend/app.css" />
    <FrontendAsset Include="$(MSBuildProjectDirectory)/../../../frontend/home.css" />
    <FrontendAsset Include="$(MSBuildProjectDirectory)/../../../frontend/player-profile.css" />
    <TeamLogoAsset Include="$(MSBuildProjectDirectory)/../../../frontend/assets/teams/*.png" />
    <FrontendAsset Include="$(MSBuildProjectDirectory)/../../../frontend/app.js" />
    <FrontendAsset Include="$(MSBuildProjectDirectory)/../../../frontend/games.js" />
    <FrontendAsset Include="$(MSBuildProjectDirectory)/../../../frontend/diamond.js" />
    <FrontendAsset Include="$(MSBuildProjectDirectory)/../../../frontend/analysis.js" />
    <FrontendAsset Include="$(MSBuildProjectDirectory)/../../../frontend/analysis.css" />
    <FrontendAsset Include="$(MSBuildProjectDirectory)/../../../frontend/comparison.js" />
    <FrontendAsset Include="$(MSBuildProjectDirectory)/../../../frontend/comparison.css" />
    <DiamondAsset Include="$(MSBuildProjectDirectory)/../../../frontend/diamond/**/*" />
    <Content Include="../../../diamond-game/lib/players.json;../../../diamond-game/lib/arsenals.json;../../../diamond-game/lib/action-data.json;../../../diamond-game/lib/player-profiles.json;../../../diamond-game/lib/batter-colliders.json"
             Link="diamond-data/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="appsettings*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Remove="appsettings.Local.json" />
    <None Include="appsettings.Local.json" Condition="Exists('appsettings.Local.json')" />
  </ItemGroup>
  <!-- Run before static asset discovery, including on a clean checkout. Do not
       replace this with virtual Link=wwwroot items: they do not create the folder. -->
  <Target Name="SyncFrontendAssets" BeforeTargets="PrepareForBuild;AssignTargetPaths;ResolveProjectStaticWebAssets">
    <Error Condition="!Exists('%(FrontendAsset.Identity)')"
           Text="Required frontend file is missing: %(FrontendAsset.Identity)" />
    <MakeDir Directories="$(MSBuildProjectDirectory)/wwwroot" />
    <Copy SourceFiles="@(FrontendAsset)"
          DestinationFiles="@(FrontendAsset->'$(MSBuildProjectDirectory)/wwwroot/%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/../../../frontend/diamond/index.html')"
           Text="야구게임 번들이 없습니다. WEB/diamond-game에서 npm ci와 npm run build를 실행하세요." />
    <Copy SourceFiles="@(DiamondAsset)"
          DestinationFiles="@(DiamondAsset->'$(MSBuildProjectDirectory)/wwwroot/diamond/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(TeamLogoAsset)"
          DestinationFiles="@(TeamLogoAsset->'$(MSBuildProjectDirectory)/wwwroot/assets/teams/%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <Content Include="@(TeamLogoAsset->'$(MSBuildProjectDirectory)/wwwroot/assets/teams/%(Filename)%(Extension)')"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <Content Include="@(DiamondAsset->'$(MSBuildProjectDirectory)/wwwroot/diamond/%(RecursiveDir)%(Filename)%(Extension)')"
               CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
